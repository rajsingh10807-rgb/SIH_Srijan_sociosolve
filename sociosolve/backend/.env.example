# Copy this file to `.env` in the same folder and fill in real values.

# --- Database ---
DATABASE_URL=sqlite:///./sociosolve.db

# --- Auth ---
# Any long random string. `python -c "import secrets; print(secrets.token_hex(32))"`
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Hidden admin dashboard ---
# Pick a path nobody would guess. This is the ONLY door to /console — the
# public site never links to it.
ADMIN_PATH=/console-7f2a1d

# Bootstrap admin account created automatically on first run (only if no
# admin account exists yet). Log in with these at ADMIN_PATH, then feel
# free to remove them from .env.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-immediately

# --- Groq ---
# Optional: seeds the first API key automatically on first run so the app
# works immediately. Get a free key at https://console.groq.com/keys
# After this, manage/rotate keys from the hidden dashboard instead.
GROQ_API_KEY=
DEFAULT_GROQ_MODEL=llama-3.3-70b-versatile

# --- CORS ---
# Comma-separated list of allowed origins, or * for any (fine for local dev).
CORS_ALLOW_ORIGINS=*
